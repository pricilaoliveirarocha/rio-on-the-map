---
import '../styles/global.css';
import SocialBar from '../components/SocialBar.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
    title: string
    description: string
    canonicalPath?: string
    image?: string
    noindex?: boolean
    structuredData?: Record<string, unknown> | Record<string, unknown>[]
}

const {
    title,
    description,
    canonicalPath = Astro.url.pathname,
    image = '/images/rio-on-the-map-social.jpg',
    noindex = false,
    structuredData = [],
} = Astro.props

const siteUrl = Astro.site ?? new URL('https://rioonthemap.com')
const canonicalUrl = new URL(canonicalPath, siteUrl)
const socialImageUrl = new URL(image, siteUrl)
const pageStructuredData = Array.isArray(structuredData) ? structuredData : [structuredData]
const jsonLd = [
    {
        '@context': 'https://schema.org',
        '@type': 'Organization',
        name: 'Rio On The Map',
        url: new URL('/', siteUrl).toString(),
    },
    {
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        name: 'Rio On The Map',
        url: new URL('/', siteUrl).toString(),
        inLanguage: 'en',
    },
    ...pageStructuredData,
]
const serializedJsonLd = JSON.stringify(jsonLd).replaceAll('<', '\\u003c')
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta
            name="viewport"
            content="width=device-width, initial-scale=1.0"
        />
        <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
        <link rel="icon" href="/favicon.ico" sizes="any" />

        <title>{title}</title>
        <meta
            name="description"
            content={description}
        />
        <meta
            name="robots"
            content={noindex ? 'noindex, follow' : 'index, follow'}
        />
        <link
            rel="canonical"
            href={canonicalUrl}
        />

        <meta property="og:type" content="website" />
        <meta property="og:site_name" content="Rio On The Map" />
        <meta property="og:locale" content="en_US" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonicalUrl} />
        <meta property="og:image" content={socialImageUrl} />
        <meta property="og:image:alt" content="Rio de Janeiro at sunset" />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />

        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={socialImageUrl} />
        <meta name="twitter:image:alt" content="Rio de Janeiro at sunset" />

        <script type="application/ld+json" set:html={serializedJsonLd} />
    </head>

    <body>
        <a class="skip-link" href="#main-content">Skip to main content</a>
        <SocialBar />
        <Header />
        <slot />
        <Footer />
    </body>
</html>
