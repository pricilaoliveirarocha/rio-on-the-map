const { name, size = 24, draw = false } = Astro.props
---

<svg class="icon" viewBox="0 0 24 24" width={size} height={size} fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" data-draw={draw || undefined}>
    {paths[name].map((d) => <path d={d} pathLength="1" />)}
</svg>
