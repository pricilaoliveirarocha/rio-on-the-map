---
import BaseLayout from '../layouts/BaseLayout.astro'
import '../styles/pages.css'
---

<BaseLayout
    title="Contact Rio On The Map | Plan a Private Tour"
    description="Contact Rio On The Map to discuss a private tour or personalized experience in Rio de Janeiro."
    canonicalPath="/contact/"
>
    <main id="main-content" class="page-main">
        <header class="page-intro">
            <div class="container">
                <span class="page-kicker">Plan your visit</span>
                <h1>Tell us how you want to experience Rio.</h1>
                <p>
                    Share your travel dates, group size and interests. This is an inquiry—not an instant booking—and the
                    details of your experience will be discussed directly.
                </p>
            </div>
        </header>

        <section class="content-section" aria-labelledby="contact-title">
            <div class="container content-grid">
                <div>
                    <h2 id="contact-title">Start your enquiry</h2>
                    <p>We will use the information you provide only to respond to your request.</p>
                    <a class="primary-link" href="mailto:rioonthemap@gmail.com">Email Rio On The Map</a>
                </div>
                <div>
                    <h2>Helpful details to include</h2>
                    <p>Travel dates, number of guests, preferred language, interests and any mobility considerations.</p>
                    <p>No booking is confirmed until the details are agreed directly with Rio On The Map.</p>
                </div>
            </div>
        </section>
    </main>
</BaseLayout>
