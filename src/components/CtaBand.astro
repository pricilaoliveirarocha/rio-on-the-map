---
import { Picture } from 'astro:assets'
import ArrowIcon from './ArrowIcon.astro'
import ctaImage from '../assets/rio-sunset-hero.png'

interface Props {
    title?: string
    text?: string
    href?: string
    label?: string
}

const {
    title = 'Start your Rio experience.',
    text = 'Tell us what you are looking for and we will shape a private day around you.',
    href = '/contact/',
    label = 'Plan your private tour',
} = Astro.props
---

<section class="cta-band" aria-labelledby="cta-title">
    <div class="cta-band__media" data-parallax>
        <Picture
            src={ctaImage}
            formats={['avif', 'webp']}
            fallbackFormat="jpg"
            widths={[640, 960, 1280, 1600]}
            sizes="100vw"
            alt=""
            loading="lazy"
            quality={74}
        />
    </div>
    <div class="container cta-band__content">
        <div>
            <h2 id="cta-title" class="display" data-lines>
                <span class="line"><span>{title}</span></span>
            </h2>
            <p class="lede" data-reveal>{text}</p>
        </div>
        <a class="button" href={href} data-reveal>
            <span>{label}</span>
            <ArrowIcon />
        </a>
    </div>
</section>
