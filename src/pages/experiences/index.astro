---
import { Image } from 'astro:assets'
import BaseLayout from '../../layouts/BaseLayout.astro'
import Icon from '../../components/Icon.astro'
import PageHero from '../../components/PageHero.astro'
import RouteMap from '../../components/RouteMap.astro'
import heroImage from '../../assets/photos/pedra-da-gavea-aerial.jpg'
import { chapters } from '../../data/experiences'
import '../../styles/experiences.css'
---

<BaseLayout
    title="Private Tours & Experiences in Rio de Janeiro | Rio On The Map"
    description="Private tours in Rio de Janeiro: iconic landmarks, Tijuca forest, Petrópolis, Ilha Grande, Búzios, nightlife and fully custom experiences."
>
    <main id="main-content">
        <PageHero image={heroImage} alt="Aerial view of Pedra da Gávea and the coast of Rio de Janeiro" focus="50% 40%">
            <h1 class="title-1">Unforgettable tours<br />in Rio de Janeiro</h1>
            <p>From iconic landmarks to off-the-beaten-path treasures, each experience is private and shaped around you.</p>
        </PageHero>

        <section class="section tours" id="tours" aria-labelledby="tours-title">
            <div class="wrap">
                <div class="section-head">
                    <h2 id="tours-title" class="title-2">Find your private experience</h2>
                    <p class="muted">Every tour can be customized to your interests and pace.</p>
                </div>

                <div class="filters" role="group" aria-label="Filter tours by type" data-filters hidden>
                    <button type="button" aria-pressed="true" data-filter="all">All tours</button>
                    {chapters.map((chapter) => <button type="button" aria-pressed="false" data-filter={chapter.id}>{chapter.title}</button>)}
                </div>

                <ul class="tour-grid">
                    {
                        chapters.flatMap((chapter) =>
                            chapter.tours.map((tour) => (
                                <li class="tour card" id={tour.slug} data-chapter={chapter.id}>
                                    <div class="tour__media">
                                        <Image src={tour.image} alt={tour.imageAlt} widths={[400, Math.min(tour.image.width, 700)]} sizes="(max-width: 620px) 92vw, (max-width: 980px) 46vw, 30vw" />
                                        <span class="tour__place">
                                            <Icon name="pin" size={16} />
                                            {tour.stops.map((stop) => stop.label).join(' & ') || 'Anywhere you like'}
                                        </span>
                                    </div>
                                    <div class="tour__body">
                                        <h3 class="title-3">{tour.name}</h3>
                                        <p class="muted">{tour.description}</p>
                                        <p class="tour__meta"><Icon name="group" size={18} /> Private tour · {chapter.title}</p>
                                        <a class="btn btn--outline" href={`/?tour=${tour.slug}#inquiry`} aria-label={`Ask about the ${tour.name}`}>Ask about this tour</a>
                                    </div>
                                </li>
                            )),
                        )
                    }
                </ul>
            </div>
        </section>

        <section class="section where" aria-labelledby="where-title">
            <div class="wrap where__inner">
                <div class="where__copy">
                    <h2 id="where-title" class="title-2">Where our tours go</h2>
                    <p class="muted">From Rio’s landmarks to the mountains of Petrópolis, the islands of Ilha Grande and the beaches of Búzios and Arraial do Cabo.</p>
                </div>
                <RouteMap />
            </div>
        </section>
    </main>
</BaseLayout>

<script>
    const filters = document.querySelector<HTMLElement>('[data-filters]')!
    const buttons = [...filters.querySelectorAll<HTMLButtonElement>('[data-filter]')]
    const cards = [...document.querySelectorAll<HTMLElement>('[data-chapter]')]

    const apply = (filter: string) => {
        buttons.forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.filter === filter)))
        cards.forEach((card) => {
            card.hidden = filter !== 'all' && card.dataset.chapter !== filter
        })
    }

    filters.hidden = false
    buttons.forEach((button) => button.addEventListener('click', () => apply(button.dataset.filter!)))

    /* Links such as /experiences/#hidden-gems open with that filter applied. */
    const fromHash = location.hash.slice(1)
    if (buttons.some((button) => button.dataset.filter === fromHash)) {
        apply(fromHash)
        document.getElementById('tours')?.scrollIntoView()
    }
</script>
