---
import type { ImageMetadata } from 'astro'
import { Image } from 'astro:assets'

interface Props {
    image: ImageMetadata
    alt: string
    href: string
    action: string
    tone: 'aqua' | 'yellow'
}

const { image, alt, href, action, tone } = Astro.props
---

<section class={`band band--${tone}`}>
    <div class="wrap band__inner">
        <div class="band__copy">
            <h2 class="title-2"><slot name="title" /></h2>
            <p><slot /></p>
            <a class="btn btn--white" href={href}>{action}</a>
        </div>
        <div class="band__media">
            <Image src={image} format="webp" widths={[600, 900, Math.min(image.width, 1280)]} sizes="(max-width: 820px) 92vw, 56vw" alt={alt} />
        </div>
    </div>
</section>
