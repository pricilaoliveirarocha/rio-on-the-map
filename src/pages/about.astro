---
import { Image } from 'astro:assets'
import BaseLayout from '../layouts/BaseLayout.astro'
import Icon from '../components/Icon.astro'
import PhotoBand from '../components/PhotoBand.astro'
import aboutImage from '../assets/experiences/rio-buzios-arraial.jpg'
import { approachSteps, principles, ratings, reviews } from '../data/site'
import '../styles/about.css'
---

<BaseLayout
    title="About Us | Rio On The Map, Private Tours in Rio de Janeiro"
    description="Over 10 years showing travelers the real Rio de Janeiro. Meet Rio On The Map: our story, our philosophy and how we shape every private tour with you."
    headerOn="paper"
>
    <main id="main-content">
        <header class="about-hero">
            <div class="about-hero__media">
                <Image src={aboutImage} alt="Calm green water and a sandy beach framed by rocks in Búzios" widths={[500, 830]} sizes="(max-width: 860px) 92vw, 46vw" loading="eager" />
            </div>
            <div class="about-hero__copy">
                <h1 class="display">Passion for Rio,<br /><span class="tint-green">Curated for You</span></h1>
                <p class="lede">
                    We are locals who never got tired of showing people our city. That is the whole idea behind
                    Rio On The Map: one private group, one local guide, and a day that actually fits you.
                </p>
            </div>
        </header>

        <section class="story" aria-labelledby="story-title">
            <h2 id="story-title" class="display display--md" data-reveal>Our Story</h2>
            <div class="story__body" data-reveal>
                <p>
                    Rio de Janeiro is more than its famous landmarks. It is a city of breathtaking landscapes, vibrant
                    culture and hidden gems waiting to be discovered, and it changes completely depending on who shows
                    it to you.
                </p>
                <p>
                    With over 10 years of experience, we create personalized and exclusive tours for travelers who want
                    the real Rio, in a unique, authentic and memorable way.
                </p>
                <ul class="scores">
                    {
                        ratings.map((rating) => (
                            <li>
                                <a href={rating.href} target="_blank" rel="noopener noreferrer">
                                    <strong>{rating.score.toFixed(1)}</strong>
                                    <span>{rating.platform}<br />{rating.count}</span>
                                </a>
                            </li>
                        ))
                    }
                    <li class="scores__years">
                        <strong>10+</strong>
                        <span>Years of<br />experience</span>
                    </li>
                </ul>
            </div>
        </section>

        <section class="philosophy" aria-labelledby="philosophy-title">
            <h2 id="philosophy-title" class="display display--md" data-reveal>Our Philosophy</h2>
            <ul class="principles" data-reveal>
                {
                    principles.map((principle) => (
                        <li>
                            <Icon name={principle.icon} size={40} />
                            <h3>{principle.title}</h3>
                            <p>{principle.text}</p>
                        </li>
                    ))
                }
            </ul>
        </section>

        <section class="approach" aria-labelledby="approach-title">
            <div class="approach__head" data-reveal>
                <h2 id="approach-title" class="display display--md">Our Approach<br /><span class="tint-yellow">to Private Tours</span></h2>
                <p class="lede">There is no fixed script and no instant checkout. It starts with a conversation.</p>
            </div>
            <ol class="steps" data-reveal>
                {
                    approachSteps.map((step, index) => (
                        <li>
                            <span class="steps__number" aria-hidden="true">{index + 1}</span>
                            <div>
                                <h3>{step.title}</h3>
                                <p>{step.text}</p>
                            </div>
                        </li>
                    ))
                }
            </ol>
        </section>

        <section class="voices" aria-labelledby="voices-title">
            <h2 id="voices-title" class="display display--md" data-reveal>What Our Clients Say</h2>
            <ul class="voices__list" data-reveal>
                {
                    reviews.map((review) => (
                        <li>
                            <blockquote>“{review.quote.replace(/“/g, '‘').replace(/”/g, '’')}”</blockquote>
                            <p>
                                <strong>{review.author}</strong>
                                <span>{review.origin} · {review.date}</span>
                            </p>
                        </li>
                    ))
                }
            </ul>
        </section>

        <PhotoBand href="/contact/" action="Contact Us">
            <Fragment slot="title">Ready to Explore<br />Rio with Us?</Fragment>
            Get in touch and let’s create a personalized experience just for you.
        </PhotoBand>
    </main>
</BaseLayout>

<script>
    import { initReveal } from '../scripts/motion'

    initReveal()
</script>
