---
import { Image } from 'astro:assets'
import BaseLayout from '../layouts/BaseLayout.astro'
import Arrow from '../components/Arrow.astro'
import Icon from '../components/Icon.astro'
import heroImage from '../assets/rio-sunset-hero.png'
import { site } from '../data/site'
import '../styles/contact.css'

const channels = [
    { icon: 'whatsapp', name: 'WhatsApp', detail: site.whatsappDisplay, href: site.whatsappUrl, external: true },
    { icon: 'instagram', name: 'Instagram', detail: site.instagramHandle, href: site.instagramUrl, external: true },
    { icon: 'mail', name: 'Email', detail: site.email, href: `mailto:${site.email}`, external: false },
    { icon: 'facebook', name: 'Facebook', detail: 'RioOnTheMap', href: site.facebookUrl, external: true },
    { icon: 'star', name: 'Tripadvisor', detail: '4.9 from 95 reviews', href: site.tripadvisorUrl, external: true },
    { icon: 'pin', name: 'Google Maps', detail: '5.0 from 92 reviews', href: site.googleMapsUrl, external: true },
] as const
---

<BaseLayout
    title="Contact Us | Rio On The Map, Private Tours in Rio de Janeiro"
    description="Talk to Rio On The Map on WhatsApp, Instagram, email or Facebook, and plan your private tour in Rio de Janeiro directly with us."
>
    <main id="main-content">
        <header class="contact-hero">
            <Image class="contact-hero__image" src={heroImage} format="webp" widths={[820, 1280, 1916]} sizes="100vw" alt="Sunset over Guanabara Bay in Rio de Janeiro" loading="eager" />
            <div class="contact-hero__copy">
                <h1 class="display">Let’s Plan<br /><span class="tint-yellow">Your Journey</span></h1>
                <p>Every channel below reaches us directly. Choose the one you prefer and tell us about your trip.</p>
                <p class="contact-hero__time" data-rio-time hidden></p>
            </div>
        </header>

        <section class="channels" aria-label="Ways to reach Rio On The Map">
            <ul data-reveal>
                {
                    channels.map((channel) => (
                        <li>
                            <a class="channel" href={channel.href} {...(channel.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>
                                <span class="channel__icon"><Icon name={channel.icon} size={28} /></span>
                                <span class="channel__text">
                                    <strong>{channel.name}</strong>
                                    <span>{channel.detail}</span>
                                </span>
                                <Arrow />
                            </a>
                        </li>
                    ))
                }
            </ul>

            <p class="channels__form">
                Prefer a form? <a href="/#inquiry">Send us a message</a> from the home page.
            </p>
        </section>
    </main>
</BaseLayout>

<script>
    import { initReveal } from '../scripts/motion'

    const clock = document.querySelector<HTMLElement>('[data-rio-time]')!
    const paint = () => {
        const time = new Intl.DateTimeFormat('en-GB', { timeZone: 'America/Sao_Paulo', hour: '2-digit', minute: '2-digit', hour12: false }).format(new Date())
        clock.textContent = `Local time in Rio: ${time}`
        clock.hidden = false
    }
    paint()
    setInterval(paint, 30000)

    initReveal()
</script>
