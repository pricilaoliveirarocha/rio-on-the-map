---
import { Picture } from 'astro:assets'
import heroImage from '../assets/rio-sunset-hero.png'
import '../styles/hero.css'
---

<section
    class="hero"
    aria-labelledby="hero-title"
>
    <Picture
        src={heroImage}
        formats={['avif', 'webp']}
        fallbackFormat="jpg"
        layout="full-width"
        widths={[640, 960, 1280, 1600, 1855]}
        sizes="100vw"
        alt=""
        class="hero__image"
        pictureAttributes={{ class: 'hero__media', 'aria-hidden': 'true' }}
        loading="eager"
        fetchpriority="high"
        quality={82}
        aria-hidden="true"
    />

    <div class="container hero__content">
        <h1 id="hero-title">
            Rio,
            <br />
            Beyond
            <br />
            the <em>Expected.</em>
        </h1>

        <p class="hero__description">
            Discover Rio de Janeiro through thoughtfully curated private experiences, guided by local insight and shaped
            around you.
        </p>

        <div class="hero__actions">
            <a
                href="/experiences/"
                class="hero__button hero__button--primary"
            >
                <span>Discover Experiences</span>
            </a>

            <a
                href="/contact/"
                class="hero__button hero__button--secondary"
            >
                <span>Plan Your Private Tour</span>
            </a>
        </div>
    </div>
</section>
