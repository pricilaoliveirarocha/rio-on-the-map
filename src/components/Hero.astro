---
import '../styles/hero.css'
---

<section
    class="hero"
    aria-labelledby="hero-title"
>
    <div
        class="hero__background"
        aria-hidden="true"
    >
    </div>

    <div class="container hero__content">
        <span class="hero__eyebrow"> PRIVATE TOURS · RIO DE JANEIRO </span>

        <h1 id="hero-title">
            Discover Rio
            <br />
            Beyond the Ordinary.
        </h1>

        <p class="hero__description">
            Explore the soul of Rio de Janeiro through authentic experiences, iconic landscapes, and the perspective of
            a local guide.
        </p>

        <div class="hero__actions">
            <a
                href="/experiences"
                class="hero__button hero__button--primary"
            >
                Explore Experiences
            </a>

            <a
                href="/contact"
                class="hero__button hero__button--secondary"
            >
                Plan Your Private Tour
            </a>
        </div>
    </div>
</section>
