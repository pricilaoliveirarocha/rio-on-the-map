---
import BaseLayout from '../layouts/BaseLayout.astro'
import '../styles/pages.css'
---

<BaseLayout
    title="About Rio On The Map | Private Tours in Rio"
    description="Learn about Rio On The Map and our approach to thoughtful, locally guided private experiences in Rio de Janeiro."
    canonicalPath="/about/"
>
    <main id="main-content" class="page-main">
        <header class="page-intro">
            <div class="container">
                <span class="page-kicker">About Rio On The Map</span>
                <h1>See Rio with local perspective.</h1>
                <p>
                    Rio On The Map creates private experiences for visitors who want a more personal way to understand
                    the city.
                </p>
            </div>
        </header>

        <section class="content-section">
            <div class="container content-grid">
                <div>
                    <h2>Thoughtful, flexible and personal.</h2>
                </div>
                <div>
                    <p>
                        Our approach starts with the traveler: what you are curious about, how you prefer to move and what
                        kind of day you want to have in Rio de Janeiro.
                    </p>
                    <p>
                        We are preparing fuller information about the team and guiding approach. Until those details are
                        confirmed, contact us directly to discuss your visit and the experience you have in mind.
                    </p>
                    <a class="text-link" href="/contact/">Start a conversation</a>
                </div>
            </div>
        </section>
    </main>
</BaseLayout>
