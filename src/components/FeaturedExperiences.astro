---
import { Image } from 'astro:assets'
import { experiences } from '../data/experiences'
import '../styles/featured-experiences.css'

const featuredExperiences = experiences.slice(0, 4)
---

<section class="featured-experiences" aria-labelledby="featured-experiences-title">
    <div class="container">
        <header class="featured-experiences__header">
            <div>
                <h2 id="featured-experiences-title">Experiences<br />made <em>for you.</em></h2>
            </div>
            <p>
                From iconic landmarks to hidden corners, discover private experiences shaped around your interests,
                pace and travel style.
            </p>
        </header>

        <ul class="featured-experiences__grid">
            {
                featuredExperiences.map((experience) => (
                    <li>
                        <article class="featured-card">
                            <Image
                                src={experience.image}
                                alt={experience.imageAlt}
                                widths={[320, 480, 640]}
                                sizes="(max-width: 620px) 82vw, (max-width: 980px) 45vw, 25vw"
                                loading="lazy"
                                quality={80}
                            />
                            <div class="featured-card__shade" aria-hidden="true" />
                            <div class="featured-card__content">
                                <span>{experience.category}</span>
                                <h3><a href={`/experiences/${experience.slug}/`}>{experience.name}</a></h3>
                                <p>{experience.groupSize}</p>
                            </div>
                        </article>
                    </li>
                ))
            }
        </ul>

        <footer class="featured-experiences__footer">
            <span aria-hidden="true"></span>
            <a href="/experiences/">View all experiences</a>
        </footer>
    </div>
</section>
