---
import BaseLayout from '../layouts/BaseLayout.astro'
import { photoCredits } from '../data/photoCredits'
---

<BaseLayout title="Photo Credits | Rio On The Map" description="Attribution for photographs used on this website." noindex>
    <main id="main-content" class="section">
        <div class="wrap">
            <div class="section-head">
                <h1 class="title-1">Photo credits</h1>
                <p class="muted">These photographs come from Wikimedia Commons, used under the licenses shown and resized for this website.</p>
            </div>
            <ul style="display:grid;gap:0.75rem;max-width:48rem;margin-inline:auto">
                {
                    photoCredits.map((credit) => (
                        <li>
                            <a class="text-link" href={credit.url} target="_blank" rel="noopener noreferrer">{credit.title}</a>
                            <span class="muted"> by {credit.author}, {credit.license}</span>
                        </li>
                    ))
                }
            </ul>
        </div>
    </main>
</BaseLayout>
