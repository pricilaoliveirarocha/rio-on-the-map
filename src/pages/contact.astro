---
import BaseLayout from '../layouts/BaseLayout.astro'
import ArrowIcon from '../components/ArrowIcon.astro'
import { enquirySteps, ratings, site } from '../data/site'
import '../styles/contact.css'
---

<BaseLayout
    title="Contact Rio On The Map | Plan a Private Tour in Rio de Janeiro"
    description="Plan your private tour in Rio de Janeiro. Share your dates, group size and interests and receive a personal reply from Rio On The Map."
    canonicalPath="/contact/"
    breadcrumbs={[{ name: 'Contact', path: '/contact/' }]}
    structuredData={{
        '@context': 'https://schema.org',
        '@type': 'ContactPage',
        name: 'Contact Rio On The Map',
        url: `${site.url}/contact/`,
        about: { '@id': `${site.url}/#organization` },
    }}
>
    <main id="main-content">
        <header class="page-hero contact-hero">
            <div class="container page-hero__grid">
                <div>
                    <p class="eyebrow" data-intro>Plan your visit</p>
                    <h1 class="display display--xl" data-lines data-intro-lines>
                        <span class="line"><span>Tell us how</span></span>
                        <span class="line"><span>you want to</span></span>
                        <span class="line"><span>see <em>Rio.</em></span></span>
                    </h1>
                </div>
                <div class="page-hero__aside" data-intro>
                    <p class="lede">
                        Share your travel dates, group size and interests. We reply personally — this is an enquiry, not an
                        instant booking.
                    </p>
                </div>
            </div>
        </header>

        <section class="section contact" id="enquiry" aria-labelledby="enquiry-title">
            <div class="container contact__grid">
                <aside class="contact__aside">
                    <h2 id="enquiry-title" class="display display--md" data-lines>
                        <span class="line"><span>Start your</span></span>
                        <span class="line"><span><em>enquiry.</em></span></span>
                    </h2>

                    <ol class="steps contact__steps" data-stagger>
                        {
                            enquirySteps.map((step, index) => (
                                <li>
                                    <span class="steps__number">0{index + 1}</span>
                                    <div>
                                        <h3>{step.title}</h3>
                                        <p>{step.text}</p>
                                    </div>
                                </li>
                            ))
                        }
                    </ol>

                    <div class="contact__direct" data-reveal>
                        <p class="contact__label">Prefer email?</p>
                        <a class="contact__email" href={`mailto:${site.email}`}>{site.email}</a>
                    </div>

                    <ul class="contact__ratings" data-reveal aria-label="Public review scores">
                        {
                            ratings.map((rating) => (
                                <li>
                                    <a href={rating.href} target="_blank" rel="noopener noreferrer">
                                        <strong>{rating.score}</strong> on {rating.platform}
                                        <span class="visually-hidden">(opens in a new tab)</span>
                                    </a>
                                </li>
                            ))
                        }
                    </ul>
                </aside>

                <div class="contact__panel" data-reveal>
                    <p class="form-status" role="status" aria-live="polite" tabindex="-1" data-form-status hidden></p>

                    <form class="enquiry-form" action="/send-contact.php" method="post" accept-charset="UTF-8" data-enquiry-form>
                        <div class="enquiry-form__row">
                            <div class="field">
                                <input id="enquiry-name" type="text" name="name" autocomplete="name" minlength="2" maxlength="100" placeholder=" " required />
                                <label for="enquiry-name">Your name</label>
                            </div>
                            <div class="field">
                                <input id="enquiry-email" type="email" name="email" autocomplete="email" maxlength="160" placeholder=" " required />
                                <label for="enquiry-email">Email address</label>
                            </div>
                        </div>

                        <div class="enquiry-form__row">
                            <div class="field">
                                <input id="enquiry-dates" type="text" name="travel_dates" autocomplete="off" maxlength="100" placeholder=" " aria-describedby="enquiry-dates-hint" />
                                <label for="enquiry-dates">Travel dates <small>Optional</small></label>
                                <span class="field__hint" id="enquiry-dates-hint">For example, 10–15 May</span>
                            </div>
                            <div class="field">
                                <input id="enquiry-guests" type="number" name="guests" min="1" max="30" inputmode="numeric" placeholder=" " />
                                <label for="enquiry-guests">Number of guests <small>Optional</small></label>
                            </div>
                        </div>

                        <div class="field field--select">
                            <select id="enquiry-language" name="language" required>
                                <option value="" disabled selected hidden></option>
                                <option value="English">English</option>
                                <option value="Italian">Italian</option>
                                <option value="Portuguese">Portuguese</option>
                                <option value="Spanish">Spanish</option>
                                <option value="Other">Other</option>
                            </select>
                            <label for="enquiry-language">Preferred language</label>
                        </div>

                        <div class="field">
                            <textarea id="enquiry-message" name="message" rows="5" minlength="20" maxlength="3000" placeholder=" " required></textarea>
                            <label for="enquiry-message">What would you like to experience?</label>
                        </div>

                        <div class="enquiry-form__honeypot" aria-hidden="true">
                            <label>Leave this field empty<input type="text" name="company" tabindex="-1" autocomplete="off" /></label>
                        </div>

                        <label class="enquiry-form__consent">
                            <input type="checkbox" name="consent" value="accepted" required />
                            <span>I agree that Rio On The Map may use these details only to respond to my enquiry.</span>
                        </label>

                        <div class="enquiry-form__submit">
                            <p>This is an enquiry, not an instant booking.</p>
                            <button class="button" type="submit" data-submit-enquiry>
                                <span>Send enquiry</span>
                                <ArrowIcon />
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </section>
    </main>
</BaseLayout>

<script>
    import gsap from 'gsap'

    const status = new URLSearchParams(window.location.search).get('contact')
    const statusElement = document.querySelector<HTMLElement>('[data-form-status]')
    const messages: Record<string, string> = {
        sent: 'Thank you. Your enquiry has been sent — we will reply personally by email.',
        invalid: 'Please review the form fields and try again.',
        rate: 'Please wait a moment before sending another enquiry.',
        error: 'We could not send your message. Please email rioonthemap@gmail.com directly.',
    }

    if (statusElement && status && messages[status]) {
        statusElement.textContent = messages[status]
        statusElement.dataset.state = status
        statusElement.hidden = false
        statusElement.focus({ preventScroll: true })

        if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
            gsap.fromTo(statusElement, { y: -10, autoAlpha: 0 }, { y: 0, autoAlpha: 1, duration: 0.9, ease: 'expo.out', delay: 0.4 })
        }
    }

    const enquiryForm = document.querySelector<HTMLFormElement>('[data-enquiry-form]')
    const submitButton = enquiryForm?.querySelector<HTMLButtonElement>('[data-submit-enquiry]')
    const submitLabel = submitButton?.querySelector('span')

    enquiryForm?.addEventListener('submit', () => {
        if (!enquiryForm.checkValidity() || !submitButton) return
        submitButton.disabled = true
        if (submitLabel) submitLabel.textContent = 'Sending…'
    })
</script>
