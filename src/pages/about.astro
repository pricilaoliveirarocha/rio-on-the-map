---
import { Image } from 'astro:assets'
import BaseLayout from '../layouts/BaseLayout.astro'
import Icon from '../components/Icon.astro'
import PageHero from '../components/PageHero.astro'
import PhotoBand from '../components/PhotoBand.astro'
import heroImage from '../assets/photos/botafogo-christ-mountains.jpg'
import mosaicMain from '../assets/photos/selaron-steps-day.jpg'
import mosaicTop from '../assets/photos/rio-mountains-morning.jpg'
import mosaicBottom from '../assets/photos/taunay-waterfall-tijuca.jpg'
import bandImage from '../assets/photos/niteroi-bay-orange-sunset.jpg'
import { approachSteps, principles, ratings, reviews } from '../data/site'
import '../styles/about.css'

const totalReviews = ratings.reduce((total, rating) => total + Number.parseInt(rating.count, 10), 0)
---

<BaseLayout
    title="About Us | Rio On The Map, Private Tours in Rio de Janeiro"
    description="Over 10 years showing travelers the real Rio de Janeiro. Meet Rio On The Map: our story, our philosophy and how we shape every private tour with you."
>
    <main id="main-content" class="about">
        <PageHero image={heroImage} alt="Christ the Redeemer on Corcovado above Botafogo Bay in Rio de Janeiro" focus="50% 45%">
            <h1 class="title-1">Passion for Rio,<br />curated for you</h1>
            <p>We are locals who never got tired of showing people our city.</p>
        </PageHero>

        <div class="wrap">
            <ul class="facts card">
                <li><strong>10+</strong><span>Years of experience</span></li>
                {
                    ratings.map((rating) => (
                        <li>
                            <strong>{rating.score.toFixed(1)}</strong>
                            <span>{rating.platform} rating</span>
                        </li>
                    ))
                }
                <li><strong>{totalReviews}</strong><span>Public reviews</span></li>
            </ul>
        </div>

        <section class="section" aria-labelledby="story-title">
            <div class="wrap story">
                <div class="story__copy">
                    <h2 id="story-title" class="title-2">Our story</h2>
                    <p class="story__lead">
                        Rio de Janeiro is more than its famous landmarks, and it changes completely depending on who
                        shows it to you.
                    </p>
                    <p class="muted">
                        It is a city of breathtaking landscapes, vibrant culture and hidden gems waiting to be
                        discovered. With over 10 years of experience, we create personalized and exclusive tours for
                        travelers who want the real Rio, in a unique, authentic and memorable way.
                    </p>
                    <p class="muted">
                        Some guests come for the famous viewpoints. Others are drawn to the neighborhoods, the forest or
                        a day beyond the city. Every experience begins with a conversation, so the day reflects you.
                    </p>
                    <a class="btn btn--navy" href="/experiences/">Explore our tours</a>
                </div>
                <div class="mosaic">
                    <Image class="mosaic__main" src={mosaicMain} widths={[500, 800, 1100]} sizes="(max-width: 860px) 56vw, 26vw" alt="The colorful tiled Selarón Steps in Lapa, Rio de Janeiro" />
                    <Image src={mosaicTop} widths={[400, 700]} sizes="(max-width: 860px) 36vw, 18vw" alt="Rio de Janeiro’s green mountains rising above the city in soft morning light" />
                    <Image src={mosaicBottom} widths={[400, 700]} sizes="(max-width: 860px) 36vw, 18vw" alt="Taunay Waterfall framed by a stone arch in Tijuca National Park" />
                </div>
            </div>
        </section>

        <section class="section section--white" aria-labelledby="philosophy-title">
            <div class="wrap">
                <div class="section-head">
                    <h2 id="philosophy-title" class="title-2">Our philosophy</h2>
                    <p class="muted">Four things we never compromise on.</p>
                </div>
                <ul class="principles">
                    {
                        principles.map((principle) => (
                            <li>
                                <span class="principles__icon"><Icon name={principle.icon} size={28} /></span>
                                <h3 class="title-3">{principle.title}</h3>
                                <p class="muted">{principle.text}</p>
                            </li>
                        ))
                    }
                </ul>
            </div>
        </section>

        <section class="section" aria-labelledby="approach-title">
            <div class="wrap">
                <div class="section-head">
                    <h2 id="approach-title" class="title-2">Our approach to private tours</h2>
                    <p class="muted">There is no fixed script and no instant checkout. It starts with a conversation.</p>
                </div>
                <ol class="steps">
                    {
                        approachSteps.map((step, index) => (
                            <li>
                                <span class="steps__number" aria-hidden="true">{index + 1}</span>
                                <h3 class="title-3">{step.title}</h3>
                                <p class="muted">{step.text}</p>
                            </li>
                        ))
                    }
                </ol>
            </div>
        </section>

        <section class="section section--white" aria-labelledby="voices-title">
            <div class="wrap">
                <div class="section-head">
                    <h2 id="voices-title" class="title-2">What travelers say</h2>
                    <p class="muted">Real words from guests, with public scores you can check yourself.</p>
                </div>
                <div class="voices">
                    <ul class="scores">
                        {
                            ratings.map((rating) => (
                                <li>
                                    <div>
                                        <strong>{rating.score.toFixed(1)}</strong>
                                        <span class="muted">{rating.platform}, {rating.count}</span>
                                    </div>
                                    <a class="btn btn--outline" href={rating.href} target="_blank" rel="noopener noreferrer" aria-label={`Read reviews on ${rating.platform}`}>Read reviews</a>
                                </li>
                            ))
                        }
                    </ul>
                    <ul class="quotes">
                        {
                            reviews.map((review) => (
                                <li class="card">
                                    <blockquote>“{review.quote.replace(/“/g, '‘').replace(/”/g, '’')}”</blockquote>
                                    <p>
                                        <strong>{review.author}</strong>
                                        <span class="muted">{review.origin} · {review.date}</span>
                                    </p>
                                </li>
                            ))
                        }
                    </ul>
                </div>
            </div>
        </section>

        <PhotoBand tone="yellow" image={bandImage} alt="Orange sunset over Guanabara Bay and Rio de Janeiro, seen from Niterói" href="/contact/" action="Contact us">
            <Fragment slot="title">Ready to explore Rio with us?</Fragment>
            Get in touch and let’s create a personalized experience just for you.
        </PhotoBand>
    </main>
</BaseLayout>
