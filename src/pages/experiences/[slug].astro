---
import type { GetStaticPaths } from 'astro'
import BaseLayout from '../../layouts/BaseLayout.astro'
import { experiences, type Experience } from '../../data/experiences'
import '../../styles/pages.css'

export const getStaticPaths = (() =>
    experiences.map((experience) => ({
        params: { slug: experience.slug },
        props: { experience },
    }))) satisfies GetStaticPaths

interface Props {
    experience: Experience
}

const { experience } = Astro.props
const canonicalPath = `/experiences/${experience.slug}/`
const breadcrumbData = {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://rioonthemap.com/' },
        { '@type': 'ListItem', position: 2, name: 'Experiences', item: 'https://rioonthemap.com/experiences/' },
        { '@type': 'ListItem', position: 3, name: experience.name, item: `https://rioonthemap.com${canonicalPath}` },
    ],
}
---

<BaseLayout
    title={`${experience.name} | Rio On The Map`}
    description={`The ${experience.name} experience page is being prepared. Contact Rio On The Map to discuss a private tour in Rio de Janeiro.`}
    canonicalPath={canonicalPath}
    noindex={true}
    structuredData={breadcrumbData}
>
    <main id="main-content" class="page-main">
        <header class="page-intro">
            <div class="container">
                <span class="page-kicker">Private experience</span>
                <h1>{experience.name}</h1>
                <p>Final itinerary and practical information are currently being prepared.</p>
            </div>
        </header>

        <section class="content-section" aria-labelledby="experience-details-title">
            <div class="container">
                <h2 id="experience-details-title">Experience details</h2>
                <div class="status-note">
                    <p>
                        This is a prepared content page. Duration, itinerary, inclusions, accessibility information and
                        availability will be published only after the business confirms them.
                    </p>
                </div>

                <dl class="detail-list">
                    <div>
                        <dt>Duration</dt>
                        <dd>To be confirmed</dd>
                    </div>
                    <div>
                        <dt>Languages</dt>
                        <dd>To be confirmed</dd>
                    </div>
                    <div>
                        <dt>Meeting point</dt>
                        <dd>To be confirmed</dd>
                    </div>
                    <div>
                        <dt>Accessibility</dt>
                        <dd>To be confirmed</dd>
                    </div>
                </dl>

                <a class="primary-link" href="/contact/">Enquire about this experience</a>
            </div>
        </section>
    </main>
</BaseLayout>
