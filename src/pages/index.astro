---
import { Image } from 'astro:assets'
import BaseLayout from '../layouts/BaseLayout.astro'
import PageHero from '../components/PageHero.astro'
import PhotoBand from '../components/PhotoBand.astro'
import Icon from '../components/Icon.astro'
import InquiryForm from '../components/InquiryForm.astro'
import heroImage from '../assets/photos/sugarloaf-sunrise.jpg'
import introImage from '../assets/photos/guide-with-guests-vista-chinesa.jpg'
import beyondImage from '../assets/photos/green-islands-aerial.jpg'
import { ratings, site } from '../data/site'
import '../styles/home.css'

const promises = [
    { icon: 'diamond', title: 'Bespoke experiences', text: 'Tailored to your interests and pace' },
    { icon: 'group', title: 'Private & exclusive', text: 'Just for you and your group' },
    { icon: 'pin', title: 'Hidden gems', text: 'Beyond the typical routes' },
    { icon: 'star', title: '10+ years of experience', text: 'Local knowledge you can trust' },
] as const
---

<BaseLayout
    title="Private Tours in Rio de Janeiro | Rio On The Map"
    description="Bespoke private tours in Rio de Janeiro, from iconic landmarks to hidden gems. Rated 5.0 on Google. Write to us and start planning your days in Rio."
>
    <main id="main-content">
        <PageHero image={heroImage} alt="Sugarloaf Mountain and Guanabara Bay at sunrise, seen from above Rio de Janeiro" focus="62% 60%" tall>
            <h1 class="title-1 home-hero__title">Discover Rio de Janeiro<br />beyond the obvious</h1>
            <p>Bespoke private tours to iconic landmarks and hidden gems, designed around you.</p>
            <div class="home-hero__actions">
                <a class="btn btn--yellow" href="/experiences/">Explore experiences</a>
                <a class="btn btn--ghost" href={site.whatsappUrl} target="_blank" rel="noopener noreferrer">Chat on WhatsApp</a>
            </div>
            <ul class="home-hero__ratings">
                {
                    ratings.map((rating) => (
                        <li>
                            <a href={rating.href} target="_blank" rel="noopener noreferrer">
                                <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M12 2.5l2.9 6.2 6.8.9-5 4.7 1.300 6.700-6-3.300-6 3.300 1.300-6.700-5-4.700 6.800-.9z" /></svg>
                                <strong>{rating.score.toFixed(1)}</strong> on {rating.platform}
                            </a>
                        </li>
                    ))
                }
            </ul>
        </PageHero>

        <div class="promises">
            <ul class="wrap promises__list">
                {
                    promises.map((promise) => (
                        <li>
                            <Icon name={promise.icon} size={32} />
                            <div>
                                <strong>{promise.title}</strong>
                                <span>{promise.text}</span>
                            </div>
                        </li>
                    ))
                }
            </ul>
        </div>

        <section class="intro" aria-labelledby="intro-title">
            <div class="wrap intro__inner">
                <div class="intro__media">
                    <Image src={introImage} widths={[600, 900, 1400]} sizes="(max-width: 860px) 92vw, 44vw" alt="A local guide showing guests the view of Rio de Janeiro from Vista Chinesa" />
                </div>
                <div class="intro__copy">
                    <h2 id="intro-title" class="title-2">Your Rio, privately curated</h2>
                    <p>
                        Rio On The Map is a local private-tour company with over 10 years of experience. We open the
                        city the way we would for friends: at your pace, around your curiosity, and only for your group.
                    </p>
                    <ul class="stats">
                        <li><span>Experience</span><strong>10+ years</strong></li>
                        {
                            ratings.map((rating) => (
                                <li>
                                    <a href={rating.href} target="_blank" rel="noopener noreferrer">{rating.platform} rating</a>
                                    <strong>{rating.score.toFixed(1)} <small>({rating.count})</small></strong>
                                </li>
                            ))
                        }
                    </ul>
                    <a class="btn btn--outline" href="/about/">Our story</a>
                </div>
            </div>
        </section>

        <PhotoBand tone="aqua" image={beyondImage} alt="Small green islands with white-sand beaches in turquoise water off the Rio de Janeiro coast" href="/experiences/#hidden-gems" action="Explore hidden gems">
            <Fragment slot="title">A different side of Rio awaits</Fragment>
            Secluded beaches, breathtaking viewpoints and authentic local spots that most travelers never see.
        </PhotoBand>

        <section class="section inquiry" id="inquiry" aria-labelledby="inquiry-title">
            <div class="wrap">
                <div class="section-head">
                    <h2 id="inquiry-title" class="title-2">Questions and requests</h2>
                    <p class="muted">
                        Tell us what you have in mind and we will reply personally. Prefer to chat? We are also on{' '}
                        <a class="text-link" href={site.whatsappUrl} target="_blank" rel="noopener noreferrer">WhatsApp</a>.
                    </p>
                </div>
                <InquiryForm />
            </div>
        </section>
    </main>
</BaseLayout>

<script>
    import { experiences } from '../data/experienceNames'

    const form = document.querySelector<HTMLFormElement>('[data-inquiry-form]')!
    const status = document.querySelector<HTMLElement>('[data-inquiry-status]')!
    const params = new URLSearchParams(location.search)

    const tourName = experiences[params.get('tour') ?? '']
    if (tourName) {
        form.querySelector<HTMLTextAreaElement>('[data-inquiry-message]')!.value = `I would love to know more about the ${tourName}.`
    }

    const messages: Record<string, string> = {
        sent: 'Thank you. Your message has been sent and we will reply personally by email.',
        invalid: 'Something is missing. Please check the fields and try again.',
        rate: 'We have just received a message from you. Please wait a minute before sending another.',
        error: 'We could not send your message. Please try WhatsApp or email instead.',
    }
    const result = params.get('contact') ?? ''
    if (messages[result]) {
        status.textContent = messages[result]
        status.hidden = false
        status.dataset.result = result
    }
</script>
