---
import { Picture } from 'astro:assets'
import storyImage from '../assets/rio-sunset-hero.png'
import '../styles/home-stories.css'

const tripadvisorUrl =
    'https://www.tripadvisor.com/Attraction_Review-g303506-d6868124-Reviews-Rio_On_the_Map-Rio_de_Janeiro_State_of_Rio_de_Janeiro.html'
const googleMapsUrl = 'https://www.google.com/maps/search/?api=1&query=Rio+On+The+Map+Rio+de+Janeiro'

const reviews = [
    {
        platform: 'Tripadvisor',
        quote: 'Friendly and passionate about his city.',
        author: 'Niclas P.',
        origin: 'Stockholm, Sweden',
        date: 'March 2026',
    },
    {
        platform: 'Tripadvisor',
        quote: 'He knows the cool “out of the way” spots.',
        author: 'Karen P.',
        origin: 'Tripadvisor traveler',
        date: 'August 2025',
    },
    {
        platform: 'Tripadvisor',
        quote: 'Always punctual and an excellent driver.',
        author: 'Aneal K.',
        origin: 'Virginia, United States',
        date: 'November 2023',
    },
]
---

<section class="guest-stories" aria-labelledby="guest-stories-title">
    <div class="container">
        <div class="guest-stories__header">
            <div class="guest-stories__intro">
                <p class="section-kicker">Guest reviews</p>
                <h2 id="guest-stories-title">Real stories<br />from real travelers.</h2>
                <p>Independent feedback shared by guests after experiencing Rio with our local guides.</p>
            </div>

            <div class="review-scores" aria-label="Public review scores verified in October 2026">
                <article class="review-score">
                    <div class="review-score__brand">
                        <span class="review-score__google" aria-hidden="true">G</span>
                        <span>Google</span>
                    </div>
                    <p><strong>5.0</strong><span>/5</span></p>
                    <small>92 public reviews</small>
                    <a href={googleMapsUrl} target="_blank" rel="noopener noreferrer">View on Google Maps</a>
                </article>

                <article class="review-score">
                    <div class="review-score__brand">
                        <svg class="review-score__tripadvisor" viewBox="0 0 48 28" aria-hidden="true">
                            <path d="M16 7h16M19 4h10" />
                            <circle cx="14" cy="16" r="8" />
                            <circle cx="34" cy="16" r="8" />
                            <circle cx="14" cy="16" r="2.5" />
                            <circle cx="34" cy="16" r="2.5" />
                            <path d="m22 17 2 3 2-3M6 10 2 7M42 10l4-3" />
                        </svg>
                        <span>Tripadvisor</span>
                    </div>
                    <p><strong>4.9</strong><span>/5</span></p>
                    <small>95 traveler reviews</small>
                    <a href={tripadvisorUrl} target="_blank" rel="noopener noreferrer">View on Tripadvisor</a>
                </article>
            </div>
        </div>

        <div class="review-grid">
            {
                reviews.map((review) => (
                    <article class="review-card">
                        <div class="review-card__source">
                            <svg viewBox="0 0 48 28" aria-hidden="true">
                                <path d="M16 7h16M19 4h10" />
                                <circle cx="14" cy="16" r="8" />
                                <circle cx="34" cy="16" r="8" />
                                <circle cx="14" cy="16" r="2.5" />
                                <circle cx="34" cy="16" r="2.5" />
                                <path d="m22 17 2 3 2-3M6 10 2 7M42 10l4-3" />
                            </svg>
                            <span>{review.platform}</span>
                        </div>
                        <div class="review-card__stars" aria-label="5 out of 5 stars">★★★★★</div>
                        <blockquote>“{review.quote}”</blockquote>
                        <footer>
                            <div>
                                <strong>{review.author}</strong>
                                <span>{review.origin}</span>
                            </div>
                            <time>{review.date}</time>
                        </footer>
                    </article>
                ))
            }
        </div>

        <p class="review-disclosure">Ratings are a public snapshot verified in October 2026 and may change on each platform.</p>
    </div>
</section>

<section class="connection-story" aria-labelledby="connection-title">
    <div class="container connection-story__frame">
        <div class="connection-story__image">
            <Picture
                src={storyImage}
                formats={['avif', 'webp']}
                fallbackFormat="jpg"
                widths={[640, 960, 1280]}
                sizes="(max-width: 900px) 100vw, 58vw"
                alt="Rio de Janeiro and Guanabara Bay at sunset"
                loading="lazy"
                quality={78}
            />
            <p><span>Local perspective</span><strong>Rio de Janeiro</strong></p>
        </div>

        <div class="connection-story__content">
            <p class="section-kicker">Our approach</p>
            <h2 id="connection-title">More than a trip,<br />it’s a <em>connection.</em></h2>
            <p>
                Based in Ipanema, Rio On The Map creates custom private tours shaped around each traveler. Local knowledge,
                thoughtful hospitality and flexible itineraries help you experience Rio beyond the familiar landmarks.
            </p>
            <ul aria-label="How we design each experience">
                <li>Private by design</li>
                <li>Shaped around you</li>
                <li>Guided by local insight</li>
            </ul>
            <a href="/about/">Discover our story</a>
        </div>
    </div>
</section>
