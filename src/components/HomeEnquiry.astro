---
import '../styles/home-enquiry.css'
---

<section class="home-enquiry" id="plan-your-tour" aria-labelledby="enquiry-title">
    <div class="container home-enquiry__layout">
        <div class="home-enquiry__intro">
            <p class="home-enquiry__kicker">Plan your private experience</p>
            <h2 id="enquiry-title">Tell us what your<br />perfect day in Rio<br /><em>looks like.</em></h2>
            <p>
                Share a few details about your visit. Your message will go directly to Rio On The Map so we can shape a
                thoughtful, private experience around you.
            </p>

            <ol class="home-enquiry__steps">
                <li><span>01</span><p><strong>Send your ideas</strong>Dates, group size and what interests you most.</p></li>
                <li><span>02</span><p><strong>Receive a personal reply</strong>We will discuss possibilities directly by email.</p></li>
                <li><span>03</span><p><strong>Shape the experience</strong>Nothing is booked until every detail is agreed.</p></li>
            </ol>

            <p class="home-enquiry__email">Prefer email? <a href="mailto:rioonthemap@gmail.com">rioonthemap@gmail.com</a></p>
        </div>

        <div class="home-enquiry__panel">
            <p class="form-status" role="status" aria-live="polite" tabindex="-1" data-form-status hidden></p>

            <form class="enquiry-form" action="/send-contact.php" method="post" accept-charset="UTF-8" data-enquiry-form>
                <div class="enquiry-form__row">
                    <label>
                        <span>Your name</span>
                        <input type="text" name="name" autocomplete="name" minlength="2" maxlength="100" required />
                    </label>
                    <label>
                        <span>Email address</span>
                        <input type="email" name="email" autocomplete="email" maxlength="160" required />
                    </label>
                </div>

                <div class="enquiry-form__row">
                    <label>
                        <span>Travel dates <small>Optional</small></span>
                        <input type="text" name="travel_dates" autocomplete="off" maxlength="100" placeholder="For example, 10–15 May" />
                    </label>
                    <label>
                        <span>Number of guests <small>Optional</small></span>
                        <input type="number" name="guests" min="1" max="30" inputmode="numeric" />
                    </label>
                </div>

                <label>
                    <span>Preferred language</span>
                    <select name="language" required>
                        <option value="">Select a language</option>
                        <option value="English">English</option>
                        <option value="Italian">Italian</option>
                        <option value="Portuguese">Portuguese</option>
                        <option value="Spanish">Spanish</option>
                        <option value="Other">Other</option>
                    </select>
                </label>

                <label>
                    <span>What would you like to experience?</span>
                    <textarea name="message" rows="5" minlength="20" maxlength="3000" required></textarea>
                </label>

                <div class="enquiry-form__honeypot" aria-hidden="true">
                    <label>Leave this field empty<input type="text" name="company" tabindex="-1" autocomplete="off" /></label>
                </div>

                <label class="enquiry-form__consent">
                    <input type="checkbox" name="consent" value="accepted" required />
                    <span>I agree that Rio On The Map may use these details only to respond to my enquiry.</span>
                </label>

                <div class="enquiry-form__submit">
                    <p>This is an enquiry, not an instant booking.</p>
                    <button type="submit" data-submit-enquiry>Send enquiry</button>
                </div>
            </form>
        </div>
    </div>
</section>

<script>
    const status = new URLSearchParams(window.location.search).get('contact')
    const statusElement = document.querySelector<HTMLElement>('[data-form-status]')
    const messages: Record<string, string> = {
        sent: 'Thank you. Your enquiry has been sent to Rio On The Map.',
        invalid: 'Please review the form fields and try again.',
        rate: 'Please wait a moment before sending another enquiry.',
        error: 'We could not send your message. Please email rioonthemap@gmail.com directly.',
    }

    if (statusElement && status && messages[status]) {
        statusElement.textContent = messages[status]
        statusElement.dataset.state = status
        statusElement.hidden = false
        statusElement.focus({ preventScroll: true })
    }

    const enquiryForm = document.querySelector<HTMLFormElement>('[data-enquiry-form]')
    const submitButton = enquiryForm?.querySelector<HTMLButtonElement>('[data-submit-enquiry]')

    enquiryForm?.addEventListener('submit', () => {
        if (!enquiryForm.checkValidity() || !submitButton) return
        submitButton.disabled = true
        submitButton.textContent = 'Sending…'
    })
</script>
