---
import { Picture } from 'astro:assets'
import BaseLayout from '../../layouts/BaseLayout.astro'
import ArrowIcon from '../../components/ArrowIcon.astro'
import ExperienceCard from '../../components/ExperienceCard.astro'
import { experiences } from '../../data/experiences'
import { site } from '../../data/site'
import '../../styles/experiences.css'

const customExperience = experiences.find(({ slug }) => slug === 'customize-your-own-experience')
const catalogExperiences = experiences.filter(({ slug }) => slug !== 'customize-your-own-experience')
const filters = [
    { label: 'All', value: 'all' },
    { label: 'City highlights', value: 'city' },
    { label: 'Nature & beaches', value: 'nature' },
    { label: 'Culture & history', value: 'culture' },
    { label: 'Food & lifestyle', value: 'food' },
    { label: 'Sunset & nightlife', value: 'nightlife' },
    { label: 'Multi-day', value: 'multiday' },
].filter(({ value }) => value === 'all' || catalogExperiences.some(({ categories }) => categories.includes(value)))

const itemList = {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Private tour experiences in Rio de Janeiro',
    numberOfItems: catalogExperiences.length,
    itemListElement: catalogExperiences.map((experience, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: experience.name,
    })),
}
---

<BaseLayout
    title="Private Rio de Janeiro Tours & Day Trips | Rio On The Map"
    description="Private tours in Rio de Janeiro and day trips to Petrópolis, Niterói, Búzios and Ilha Grande — shaped around your interests, with local guides."
    canonicalPath="/experiences/"
    breadcrumbs={[{ name: 'Experiences', path: '/experiences/' }]}
    structuredData={itemList}
>
    <main id="main-content">
        <header class="page-hero experiences-hero">
            <div class="container page-hero__grid">
                <div>
                    <p class="eyebrow" data-intro>Experiences with us</p>
                    <h1 class="display display--xl" data-lines data-intro-lines>
                        <span class="line"><span>Private tours</span></span>
                        <span class="line"><span>in <em>Rio de Janeiro.</em></span></span>
                    </h1>
                </div>
                <div class="page-hero__aside" data-intro>
                    <p class="lede">
                        From world-famous landmarks to hidden corners and day trips beyond the city — every experience is
                        private, unhurried and shaped around you.
                    </p>
                </div>
            </div>
        </header>

        <section class="section experiences-catalog" aria-labelledby="catalog-title" data-experience-catalog>
            <div class="container">
                <h2 id="catalog-title" class="visually-hidden">All experiences</h2>

                <div class="catalog-toolbar" data-intro>
                    <div class="catalog-filters" role="group" aria-label="Filter experiences by theme">
                        {
                            filters.map((filter, index) => (
                                <button
                                    type="button"
                                    class="catalog-filter"
                                    data-filter={filter.value}
                                    aria-pressed={index === 0 ? 'true' : 'false'}
                                >
                                    {filter.label}
                                </button>
                            ))
                        }
                    </div>
                    <p class="catalog-count" aria-live="polite" data-experience-results>
                        {catalogExperiences.length} experiences
                    </p>
                </div>

                <ul class="experience-grid" data-experience-list data-stagger>
                    {
                        catalogExperiences.map((experience, index) => (
                            <li data-experience-card data-categories={experience.categories.join(' ')}>
                                <ExperienceCard experience={experience} eager={index < 3} />
                            </li>
                        ))
                    }
                </ul>
            </div>
        </section>

        {
            customExperience && (
                <section class="section section--surface custom-experience" aria-labelledby="custom-title">
                    <div class="container custom-experience__grid">
                        <div class="custom-experience__media" data-clip>
                            <Picture
                                src={customExperience.image}
                                formats={['avif', 'webp']}
                                fallbackFormat="jpg"
                                widths={[480, 640]}
                                sizes="(max-width: 860px) 100vw, 50vw"
                                alt={customExperience.imageAlt}
                                loading="lazy"
                                quality={82}
                            />
                        </div>

                        <div class="custom-experience__content">
                            <p class="eyebrow" data-reveal>Made for you</p>
                            <h2 id="custom-title" class="display display--md" data-lines>
                                <span class="line"><span>Customize your</span></span>
                                <span class="line"><span>own <em>experience.</em></span></span>
                            </h2>
                            <p class="lede" data-reveal>
                                Not seeing exactly what you have in mind? Begin with your interests and we will shape a
                                private day — or several — around the way you want to see Rio.
                            </p>
                            <div class="button-row" data-reveal>
                                <a class="button" href="/contact/">
                                    <span>Design my experience</span>
                                    <ArrowIcon />
                                </a>
                                <a class="button button--ghost" href={`mailto:${site.email}`}>
                                    <span>Email us</span>
                                </a>
                            </div>
                        </div>
                    </div>
                </section>
            )
        }
    </main>
</BaseLayout>

<script>
    import gsap from 'gsap'
    import { ScrollTrigger } from 'gsap/ScrollTrigger'

    const catalog = document.querySelector('[data-experience-catalog]')

    if (catalog) {
        const buttons = [...catalog.querySelectorAll<HTMLButtonElement>('[data-filter]')]
        const cards = [...catalog.querySelectorAll<HTMLElement>('[data-experience-card]')]
        const results = catalog.querySelector('[data-experience-results]')
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)')

        const applyFilter = (value: string) => {
            const visibleCards: HTMLElement[] = []

            cards.forEach((card) => {
                const categories = card.dataset.categories?.split(' ') ?? []
                const isVisible = value === 'all' || categories.includes(value)
                card.hidden = !isVisible
                if (isVisible) visibleCards.push(card)
            })

            if (results) {
                results.textContent = `${visibleCards.length} ${visibleCards.length === 1 ? 'experience' : 'experiences'}`
            }

            if (!reduceMotion.matches) {
                gsap.killTweensOf(visibleCards)
                gsap.fromTo(
                    visibleCards,
                    { y: 28, autoAlpha: 0 },
                    { y: 0, autoAlpha: 1, duration: 0.9, stagger: 0.06, ease: 'expo.out' },
                )
            }

            ScrollTrigger.refresh()
        }

        buttons.forEach((button) => {
            button.addEventListener('click', () => {
                if (button.getAttribute('aria-pressed') === 'true') return
                buttons.forEach((item) => item.setAttribute('aria-pressed', String(item === button)))
                applyFilter(button.dataset.filter ?? 'all')
            })
        })
    }
</script>
