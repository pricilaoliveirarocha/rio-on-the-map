---
import '@fontsource/dm-serif-display/400.css'
import '@fontsource-variable/figtree/index.css'
import '../styles/global.css'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import { site } from '../data/site'

interface Props {
    title: string
    description: string
    /** Colour of the content the transparent header sits on at the top of the page. */
    headerOn?: 'photo' | 'paper'
    noindex?: boolean
}

const { title, description, headerOn = 'photo', noindex = false } = Astro.props
const canonical = new URL(Astro.url.pathname, site.url).href
const socialImage = new URL('/images/rio-on-the-map-social.jpg', site.url).href
const organization = {
    '@context': 'https://schema.org',
    '@type': 'TravelAgency',
    name: site.name,
    url: site.url,
    email: site.email,
    telephone: '+5521999040267',
    areaServed: 'Rio de Janeiro, Brazil',
    sameAs: [site.instagramUrl, site.facebookUrl, site.tripadvisorUrl, site.googleMapsUrl],
}
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>{title}</title>
        <meta name="description" content={description} />
        <link rel="canonical" href={canonical} />
        {noindex && <meta name="robots" content="noindex" />}
        <meta name="theme-color" content="#0B2D4D" />
        <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
        <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
        <link rel="sitemap" href="/sitemap-index.xml" />
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content={site.name} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonical} />
        <meta property="og:image" content={socialImage} />
        <meta name="twitter:card" content="summary_large_image" />
        <script type="application/ld+json" set:html={JSON.stringify(organization)} />
        <script is:inline>
            ;(function () {
                var root = document.documentElement
                root.classList.add('js')
                if (matchMedia('(prefers-reduced-motion: reduce)').matches) return
                root.classList.add('anim')
                // Never leave content hidden if the motion bundle fails to load.
                setTimeout(function () {
                    if (!root.classList.contains('ready')) root.classList.remove('anim')
                }, 2500)
            })()
        </script>
    </head>
    <body>
        <a class="skip-link" href="#main-content">Skip to content</a>
        <Header on={headerOn} />
        <slot />
        <Footer />
    </body>
</html>
