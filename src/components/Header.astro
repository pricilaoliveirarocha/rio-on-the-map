---
import { Image } from 'astro:assets'
import logo from '../assets/logo-rio.png'
import { navigation } from '../data/site'

interface Props {
    on: 'photo' | 'paper'
}

const { on } = Astro.props
const currentPath = Astro.url.pathname
---

<header class={`site-header site-header--on-${on}`} data-header>
    <a class="brand" href="/">
        <Image class="brand__logo" src={logo} alt="" width={56} widths={[56, 112]} sizes="56px" loading="eager" />
        <span class="brand__name">Rio on the Map</span>
    </a>

    <nav class="site-nav" id="site-nav" aria-label="Main">
        <ul>
            {
                navigation.map((item) => (
                    <li>
                        <a href={item.href} aria-current={currentPath === item.href ? 'page' : undefined}>
                            {item.label}
                        </a>
                    </li>
                ))
            }
        </ul>
    </nav>

    <a class="site-header__cta" href="/#inquiry">Plan Your Tour</a>

    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav" data-menu-toggle>
        <span class="visually-hidden">Menu</span>
        <span class="menu-toggle__bars" aria-hidden="true"></span>
    </button>
</header>

<script>
    const header = document.querySelector<HTMLElement>('[data-header]')!
    const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]')!

    const setMenu = (open: boolean) => {
        toggle.setAttribute('aria-expanded', String(open))
        header.classList.toggle('is-open', open)
        document.documentElement.classList.toggle('menu-open', open)
    }

    toggle.addEventListener('click', () => setMenu(toggle.getAttribute('aria-expanded') !== 'true'))
    addEventListener('keydown', (event) => {
        if (event.key === 'Escape') setMenu(false)
    })

    const updateScrolled = () => header.classList.toggle('is-scrolled', scrollY > 40)
    updateScrolled()
    addEventListener('scroll', updateScrolled, { passive: true })
</script>
