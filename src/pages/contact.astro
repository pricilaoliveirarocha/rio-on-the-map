---
import BaseLayout from '../layouts/BaseLayout.astro'
import Icon from '../components/Icon.astro'
import PageHero from '../components/PageHero.astro'
import heroImage from '../assets/photos/rio-bay-sunset-viewpoint.jpg'
import { site } from '../data/site'
import '../styles/contact.css'

const channels = [
    { icon: 'whatsapp', name: 'WhatsApp', detail: site.whatsappDisplay, action: 'Chat on WhatsApp', href: site.whatsappUrl, external: true },
    { icon: 'instagram', name: 'Instagram', detail: site.instagramHandle, action: 'View profile', href: site.instagramUrl, external: true },
    { icon: 'mail', name: 'Email', detail: site.email, action: 'Send an email', href: `mailto:${site.email}`, external: false },
    { icon: 'facebook', name: 'Facebook', detail: 'RioOnTheMap', action: 'View page', href: site.facebookUrl, external: true },
    { icon: 'star', name: 'Tripadvisor', detail: '4.9 from 95 reviews', action: 'Read reviews', href: site.tripadvisorUrl, external: true },
    { icon: 'pin', name: 'Google Maps', detail: '5.0 from 92 reviews', action: 'Find us', href: site.googleMapsUrl, external: true },
] as const
---

<BaseLayout
    title="Contact Us | Rio On The Map, Private Tours in Rio de Janeiro"
    description="Talk to Rio On The Map on WhatsApp, Instagram, email or Facebook, and plan your private tour in Rio de Janeiro directly with us."
>
    <main id="main-content">
        <PageHero image={heroImage} alt="The sun setting behind the mountains of Rio de Janeiro from a hilltop viewpoint" focus="50% 60%">
            <h1 class="title-1">Let’s plan your journey</h1>
            <p>Every channel below reaches us directly. Choose the one you prefer and tell us about your trip.</p>
        </PageHero>

        <section class="section" aria-labelledby="channels-title">
            <div class="wrap">
                <div class="section-head">
                    <h2 id="channels-title" class="title-2">Get in touch</h2>
                    <p class="muted" data-rio-time hidden></p>
                </div>

                <ul class="channels">
                    {
                        channels.map((channel) => (
                            <li class="card">
                                <span class="channels__icon"><Icon name={channel.icon} size={28} /></span>
                                <h3 class="title-3">{channel.name}</h3>
                                <p class="muted">{channel.detail}</p>
                                <a class="btn btn--outline" href={channel.href} aria-label={`${channel.action}: ${channel.name}`} {...(channel.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>
                                    {channel.action}
                                </a>
                            </li>
                        ))
                    }
                </ul>

                <p class="channels__form muted">
                    Prefer a form? <a class="text-link" href="/#inquiry">Send us a message</a>.
                </p>
            </div>
        </section>
    </main>
</BaseLayout>

<script>
    const clock = document.querySelector<HTMLElement>('[data-rio-time]')!
    const paint = () => {
        const time = new Intl.DateTimeFormat('en-GB', { timeZone: 'America/Sao_Paulo', hour: '2-digit', minute: '2-digit', hour12: false }).format(new Date())
        clock.textContent = `Local time in Rio: ${time}`
        clock.hidden = false
    }
    paint()
    setInterval(paint, 30000)
</script>
