---
import { Image } from 'astro:assets'
import BaseLayout from '../layouts/BaseLayout.astro'
import Icon from '../components/Icon.astro'
import PageHero from '../components/PageHero.astro'
import PhotoBand from '../components/PhotoBand.astro'
import heroImage from '../assets/experiences/rio-coast-nature.jpg'
import storyImage from '../assets/experiences/rio-tijuca-explore.jpg'
import bandImage from '../assets/rio-sunset-hero.png'
import { approachSteps, principles, ratings, reviews } from '../data/site'
import '../styles/about.css'
---

<BaseLayout
    title="About Us | Rio On The Map, Private Tours in Rio de Janeiro"
    description="Over 10 years showing travelers the real Rio de Janeiro. Meet Rio On The Map: our story, our philosophy and how we shape every private tour with you."
>
    <main id="main-content">
        <PageHero image={heroImage} alt="Long Atlantic waves rolling towards a green headland on the Rio coast" focus="50% 40%">
            <h1 class="title-1">Passion for Rio,<br />curated for you</h1>
            <p>We are locals who never got tired of showing people our city.</p>
        </PageHero>

        <section class="section" aria-labelledby="story-title">
            <div class="wrap story">
                <div class="story__copy">
                    <h2 id="story-title" class="title-2">Our story</h2>
                    <p>
                        Rio de Janeiro is more than its famous landmarks. It is a city of breathtaking landscapes,
                        vibrant culture and hidden gems waiting to be discovered, and it changes completely depending on
                        who shows it to you.
                    </p>
                    <p>
                        With over 10 years of experience, we create personalized and exclusive tours for travelers who
                        want the real Rio, in a unique, authentic and memorable way.
                    </p>
                </div>
                <div class="story__media">
                    <Image src={storyImage} width={600} alt="The Vista Chinesa pavilion silhouetted against a golden sunset in Tijuca" />
                </div>
            </div>
        </section>

        <section class="section section--white" aria-labelledby="philosophy-title">
            <div class="wrap">
                <div class="section-head">
                    <h2 id="philosophy-title" class="title-2">Our philosophy</h2>
                    <p class="muted">Four things we never compromise on.</p>
                </div>
                <ul class="principles">
                    {
                        principles.map((principle) => (
                            <li>
                                <Icon name={principle.icon} size={32} />
                                <h3 class="title-3">{principle.title}</h3>
                                <p class="muted">{principle.text}</p>
                            </li>
                        ))
                    }
                </ul>
            </div>
        </section>

        <section class="section" aria-labelledby="approach-title">
            <div class="wrap">
                <div class="section-head">
                    <h2 id="approach-title" class="title-2">Our approach to private tours</h2>
                    <p class="muted">There is no fixed script and no instant checkout. It starts with a conversation.</p>
                </div>
                <ol class="steps">
                    {
                        approachSteps.map((step, index) => (
                            <li class="card">
                                <span class="steps__number" aria-hidden="true">{index + 1}</span>
                                <h3 class="title-3">{step.title}</h3>
                                <p class="muted">{step.text}</p>
                            </li>
                        ))
                    }
                </ol>
            </div>
        </section>

        <section class="section section--white" aria-labelledby="voices-title">
            <div class="wrap">
                <div class="section-head">
                    <h2 id="voices-title" class="title-2">What travelers say</h2>
                    <p class="muted">
                        {ratings.map((rating, index) => (
                            <>
                                {index > 0 && ' · '}
                                <a class="text-link" href={rating.href} target="_blank" rel="noopener noreferrer">{rating.score.toFixed(1)} on {rating.platform}</a> ({rating.count})
                            </>
                        ))}
                    </p>
                </div>
                <ul class="voices">
                    {
                        reviews.map((review) => (
                            <li class="card">
                                <span class="voices__mark" aria-hidden="true">”</span>
                                <blockquote>{review.quote}</blockquote>
                                <p>
                                    <strong>{review.author}</strong>
                                    <span class="muted">{review.origin} · {review.date}</span>
                                </p>
                            </li>
                        ))
                    }
                </ul>
            </div>
        </section>

        <PhotoBand tone="yellow" image={bandImage} alt="Sunset over Guanabara Bay and Sugarloaf Mountain in Rio de Janeiro" href="/contact/" action="Contact us">
            <Fragment slot="title">Ready to explore Rio with us?</Fragment>
            Get in touch and let’s create a personalized experience just for you.
        </PhotoBand>
    </main>
</BaseLayout>
