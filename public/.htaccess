Options -MultiViews
RewriteEngine On

# Keep a single HTTPS, non-www origin.
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\.rioonthemap\.com$ [NC]
RewriteRule ^ https://rioonthemap.com%{REQUEST_URI} [R=301,L]

# Preserve the temporary route names used during development.
Redirect 301 /about-us /about/
Redirect 301 /contact-us /contact/

# Individual tour pages were merged into the single Experiences page.
RedirectMatch 301 ^/experiences/.+$ /experiences/

ErrorDocument 404 /404.html
