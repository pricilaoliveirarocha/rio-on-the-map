---
import '../styles/header.css'

const navigation = [
    { label: 'Home', href: '/' },
    { label: 'Experiences', href: '/experiences/' },
    { label: 'About Us', href: '/about/' },
    { label: 'Contact Us', href: '/contact/' },
]

const pathname = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`
const isCurrentPage = (href: string) => href === '/' ? pathname === '/' : pathname.startsWith(href)
---

<header class="site-header">
    <div class="container header-content">
        <a
            href="/"
            class="brand"
            aria-label="Rio On The Map - Home"
        >
            <svg
                class="brand__mark"
                viewBox="0 0 44 44"
                aria-hidden="true"
            >
                <circle cx="22" cy="22" r="18"></circle>
                <path d="M4 22h36M22 4c5 5 8 11 8 18s-3 13-8 18M22 4c-5 5-8 11-8 18s3 13 8 18M7 13h30M7 31h30"></path>
            </svg>
            <span class="brand__name">Rio On The Map</span>
        </a>

        <nav
            class="desktop-navigation"
            aria-label="Main navigation"
        >
            <ul class="navigation">
                {
                    navigation.map(({ label, href }) => (
                        <li>
                            <a
                                href={href}
                                aria-current={isCurrentPage(href) ? 'page' : undefined}
                            >
                                {label}
                            </a>
                        </li>
                    ))
                }
            </ul>
        </nav>

        <details class="mobile-navigation">
            <summary>Menu</summary>
            <nav aria-label="Mobile navigation">
                <ul>
                    {
                        navigation.map(({ label, href }) => (
                            <li>
                                <a
                                    href={href}
                                    aria-current={isCurrentPage(href) ? 'page' : undefined}
                                >
                                    {label}
                                </a>
                            </li>
                        ))
                    }
                </ul>
            </nav>
        </details>
    </div>
</header>
