---
import type { ImageMetadata } from 'astro'
import { Picture } from 'astro:assets'

interface Props {
    image: ImageMetadata
    alt: string
    /** CSS object-position, to keep the subject in frame. */
    focus?: string
    tall?: boolean
}

const { image, alt, focus = '50% 50%', tall = false } = Astro.props
---

<header class:list={['page-hero', { 'page-hero--tall': tall }]}>
    <Picture
        src={image}
        formats={['avif', 'webp']}
        fallbackFormat="webp"
        widths={[820, 1280, image.width]}
        sizes={tall ? '(max-width: 620px) 1800px, 100vw' : '100vw'}
        alt={alt}
        loading="eager"
        fetchpriority="high"
        style={`object-position:${focus}`}
    />
    <div class="wrap page-hero__copy">
        <slot />
    </div>
</header>
