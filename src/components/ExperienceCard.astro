---
import { Image } from 'astro:assets'
import type { Experience } from '../data/experiences'
import ArrowIcon from './ArrowIcon.astro'
import '../styles/experience-card.css'

interface Props {
    experience: Experience
    eager?: boolean
    headingLevel?: 'h2' | 'h3'
}

const { experience, eager = false, headingLevel = 'h3' } = Astro.props
const Heading = headingLevel
const href = `/experiences/${experience.slug}/`
---

<article class="experience-card">
    <a class="experience-card__link" href={href}>
        <div class="experience-card__media">
            <Image
                src={experience.image}
                alt={experience.imageAlt}
                widths={[360, 480, 640]}
                sizes="(max-width: 640px) 100vw, (max-width: 1040px) 50vw, 33vw"
                loading={eager ? 'eager' : 'lazy'}
                quality={80}
            />
            <span class="experience-card__category">{experience.category}</span>
        </div>

        <div class="experience-card__body">
            <Heading class="experience-card__title">{experience.name}</Heading>
            <p class="experience-card__text">{experience.description}</p>
            <div class="experience-card__meta">
                <span>{experience.groupSize} · Price {experience.price.toLowerCase()}</span>
                <span class="experience-card__arrow"><ArrowIcon /></span>
            </div>
        </div>
    </a>
</article>
