---
import { Image, Picture } from 'astro:assets'
import BaseLayout from '../layouts/BaseLayout.astro'
import Arrow from '../components/Arrow.astro'
import InquiryForm from '../components/InquiryForm.astro'
import heroImage from '../assets/rio-sunset-hero.png'
import introImage from '../assets/experiences/rio-ilha-grande-tour.jpg'
import beyondImage from '../assets/experiences/rio-coast-nature.jpg'
import { ratings, site } from '../data/site'
import '../styles/home.css'
---

<BaseLayout
    title="Private Tours in Rio de Janeiro | Rio On The Map"
    description="Bespoke private tours in Rio de Janeiro, from iconic landmarks to hidden gems. Rated 5.0 on Google. Write to us and start planning your days in Rio."
>
    <main id="main-content">
        <section class="hero" aria-labelledby="hero-title">
            <Picture
                class="hero__image"
                src={heroImage}
                formats={['avif', 'webp']}
                fallbackFormat="webp"
                widths={[820, 1280, 1916]}
                sizes="100vw"
                alt="Sugarloaf Mountain and Guanabara Bay at sunset, seen from a hillside above Rio de Janeiro"
                loading="eager"
                fetchpriority="high"
            />
            <div class="hero__copy">
                <h1 id="hero-title" class="display">
                    Discover<br /><span class="tint-yellow">Rio de Janeiro</span><br />Beyond the Obvious
                </h1>
                <p>Bespoke private tours to iconic landmarks and hidden gems, designed for unforgettable experiences in Rio.</p>
                <a class="btn" href="/experiences/">
                    Explore Experiences
                    <Arrow />
                </a>
            </div>
        </section>

        <ul class="credentials" aria-label="Why travelers choose us">
            <li><strong>10+</strong><span>Years of experience</span></li>
            <li><strong>100%</strong><span>Private tours, never shared</span></li>
            {
                ratings.map((rating) => (
                    <li>
                        <a href={rating.href} target="_blank" rel="noopener noreferrer">
                            <strong>{rating.score.toFixed(1)}</strong>
                            <span>{rating.platform}, {rating.count}</span>
                        </a>
                    </li>
                ))
            }
        </ul>

        <section class="intro" aria-labelledby="intro-title">
            <div class="intro__media" data-reveal>
                <Image src={introImage} widths={[500, 800, 1024]} sizes="(max-width: 860px) 92vw, 46vw" alt="Swimmers in a turquoise cove surrounded by forest at Ilha Grande" />
            </div>
            <div class="intro__copy" data-reveal>
                <h2 id="intro-title" class="display display--md">
                    Your Rio,<br /><span class="tint-green">Privately Curated</span>
                </h2>
                <p class="lede">
                    Rio On The Map is a local private-tour company with over 10 years of experience. We open the city
                    the way we would for friends: at your pace, around your curiosity, and only for your group.
                </p>
                <a class="btn btn--navy" href="/about/">
                    Our Story
                    <Arrow />
                </a>
            </div>
        </section>

        <section class="beyond" aria-labelledby="beyond-title">
            <Image class="beyond__image" src={beyondImage} widths={[820, 1280, 1920]} sizes="100vw" alt="Long Atlantic waves rolling towards a green headland on the Rio coast" />
            <div class="beyond__copy" data-reveal>
                <h2 id="beyond-title" class="display display--md">A Different Side<br />of Rio Awaits</h2>
                <p>Secluded beaches, breathtaking viewpoints and authentic local spots that most travelers never see.</p>
                <a class="btn" href="/experiences/#hidden-gems">
                    Explore Hidden Gems
                    <Arrow />
                </a>
            </div>
        </section>

        <section class="inquiry" id="inquiry" aria-labelledby="inquiry-title">
            <div class="inquiry__head" data-reveal>
                <h2 id="inquiry-title" class="display display--md">Questions<br /><span class="tint-green">&amp; Requests</span></h2>
                <p class="lede">
                    Tell us what you have in mind and we will reply personally. If you prefer to chat, we are also on{' '}
                    <a class="text-link" href={site.whatsappUrl} target="_blank" rel="noopener noreferrer">WhatsApp</a>.
                </p>
            </div>
            <InquiryForm />
        </section>
    </main>
</BaseLayout>

<script>
    import { initReveal } from '../scripts/motion'
    import { experiences } from '../data/experienceNames'

    initReveal()

    const form = document.querySelector<HTMLFormElement>('[data-inquiry-form]')!
    const status = document.querySelector<HTMLElement>('[data-inquiry-status]')!
    const params = new URLSearchParams(location.search)

    const tourName = experiences[params.get('tour') ?? '']
    if (tourName) {
        form.querySelector<HTMLTextAreaElement>('[data-inquiry-message]')!.value = `I would love to know more about the ${tourName}.`
    }

    const messages: Record<string, string> = {
        sent: 'Thank you. Your message has been sent and we will reply personally by email.',
        invalid: 'Something is missing. Please check the fields and try again.',
        rate: 'We have just received a message from you. Please wait a minute before sending another.',
        error: 'We could not send your message. Please try WhatsApp or email instead.',
    }
    const result = params.get('contact') ?? ''
    if (messages[result]) {
        status.textContent = messages[result]
        status.hidden = false
        status.dataset.result = result
    }
</script>
