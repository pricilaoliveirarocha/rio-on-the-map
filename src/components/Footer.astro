---
import '../styles/footer.css'

const currentYear = new Date().getFullYear()
const socialLinks = [
    {
        label: 'Instagram',
        href: 'https://www.instagram.com/rioonthemap/',
        icon: 'instagram',
    },
    {
        label: 'Facebook',
        href: 'https://www.facebook.com/RioOnTheMap/',
        icon: 'facebook',
    },
    {
        label: 'Tripadvisor',
        href: 'https://www.tripadvisor.com/Attraction_Review-g303506-d6868124-Reviews-Rio_On_the_Map-Rio_de_Janeiro_State_of_Rio_de_Janeiro.html',
        icon: 'tripadvisor',
    },
]
---

<footer class="site-footer">
    <div class="container footer-content">
        <div class="footer-main">
            <div class="footer-identity">
                <a href="/" class="footer-brand" aria-label="Rio On The Map — Home">
                    <svg class="footer-brand__mark" viewBox="0 0 44 44" aria-hidden="true">
                        <circle cx="22" cy="22" r="18"></circle>
                        <path d="M4 22h36M22 4c5 5 8 11 8 18s-3 13-8 18M22 4c-5 5-8 11-8 18s3 13 8 18M7 13h30M7 31h30"></path>
                    </svg>
                    <span>Rio On The Map</span>
                </a>
            </div>

            <nav class="footer-social" aria-label="Rio On The Map social profiles">
                {
                    socialLinks.map(({ label, href, icon }) => (
                        <a
                            href={href}
                            target="_blank"
                            rel="noopener noreferrer"
                            aria-label={`${label} — opens in a new tab`}
                            title={label}
                        >
                            {icon === 'instagram' && (
                                <svg viewBox="0 0 24 24" aria-hidden="true">
                                    <rect x="3.5" y="3.5" width="17" height="17" rx="5"></rect>
                                    <circle cx="12" cy="12" r="4"></circle>
                                    <circle class="footer-social__dot" cx="17.4" cy="6.7" r="1"></circle>
                                </svg>
                            )}
                            {icon === 'facebook' && (
                                <svg viewBox="0 0 24 24" aria-hidden="true">
                                    <path class="footer-social__fill" d="M14.2 21v-8h2.7l.4-3.1h-3.1v-2c0-.9.3-1.5 1.6-1.5h1.7V3.6c-.3 0-1.3-.1-2.5-.1-2.5 0-4.2 1.5-4.2 4.3v2.1H8V13h2.8v8h3.4Z"></path>
                                </svg>
                            )}
                            {icon === 'tripadvisor' && (
                                <svg viewBox="0 0 24 24" aria-hidden="true">
                                    <path d="M7.5 8.5 9 6.7h6l1.5 1.8M5.2 9.1 3.5 8.3M18.8 9.1l1.7-.8"></path>
                                    <circle cx="7.5" cy="13" r="4"></circle>
                                    <circle cx="16.5" cy="13" r="4"></circle>
                                    <circle class="footer-social__dot" cx="7.5" cy="13" r="1.35"></circle>
                                    <circle class="footer-social__dot" cx="16.5" cy="13" r="1.35"></circle>
                                    <path d="m10.6 16.2 1.4 2 1.4-2"></path>
                                </svg>
                            )}
                        </a>
                    ))
                }

                <span
                    class="footer-social__pending"
                    aria-label="Viator — profile link pending confirmation"
                    title="Viator profile link pending confirmation"
                >
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M4.5 6 12 19 19.5 6M8.2 6l3.8 7 3.8-7"></path>
                    </svg>
                </span>
            </nav>

            <div class="footer-location">
                <p>Private experiences</p>
                <p>Rio de Janeiro, Brazil</p>
                <nav aria-label="Footer navigation">
                    <a href="/experiences/">Experiences</a>
                    <a href="/about/">About</a>
                    <a href="/contact/">Contact</a>
                </nav>
            </div>
        </div>

       
        <p class="footer-copyright">© {currentYear} Rio On The Map. All rights reserved.</p>
    </div>
</footer>
